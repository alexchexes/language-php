PGSQL_(
      ASSOC|BAD_RESPONSE|BOTH|COMMAND_OK|EMPTY_QUERY|NUM
      |CONNECT_(ASYNC|FORCE_NEW)
      |CONNECTION_(AUTH_OK|AWAITING_RESPONSE|BAD|MADE|OK|SETENV|STARTED)
      |CONV_(
            FORCE_NULL
            |IGNORE_(DEFAULT|NOT_NULL)
      )
      |COPY_(IN|OUT)
      |DIAG_(
            (COLUMN|CONSTRAINT|DATATYPE|SCHEMA|TABLE)_NAME
            |INTERNAL_(POSITION|QUERY)
            |MESSAGE_(DETAIL|HINT|PRIMARY)
            |SEVERITY(_NONLOCALIZED)?
            |SOURCE_(FILE|FUNCTION|LINE)
            |CONTEXT|SQLSTATE|STATEMENT_POSITION
      )
      |DML_(ASYNC|ESCAPE|EXEC|NO_CONV|STRING)
      |ERRORS_(DEFAULT|SQLSTATE|TERSE|VERBOSE)
      |(NON)?FATAL_ERROR
      |LIBPQ_VERSION(_STR)?
      |NOTICE_(ALL|CLEAR|LAST)
      |POLLING_(ACTIVE|FAILED|OK|READING|WRITING)
      |SEEK_(CUR|END|SET)
      |SHOW_CONTEXT_(ALWAYS|ERRORS|NEVER)
      |STATUS_(LONG|STRING)
      |TRA(
          CE_REGRESS_MODE
          |NSACTION_(ACTIVE|IDLE|INERROR|INTRANS|UNKNOWN)
      )
      |TUPLES_(CHUNK|OK)
)
