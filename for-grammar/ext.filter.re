(
FILTER_(
        REQUIRE_(SCALAR|ARRAY)
        |NULL_ON_FAILURE|CALLBACK|DEFAULT|UNSAFE_RAW|FORCE_ARRAY
        |SANITIZE_(
                  ADD_SLASHES|MAGIC_QUOTES|STRING|STRIPPED|SPECIAL_CHARS
                  |NUMBER_(INT|FLOAT)
                  |URL|EMAIL|ENCODED|FULL_SPECIAL_CHARS
        )
        |VALIDATE_(REGEXP|BOOL(EAN)?|INT|IP|URL|EMAIL|DOMAIN|FLOAT|MAC)
        |FLAG_(
              (SCHEME|HOST|PATH|QUERY)_REQUIRED
              |STRIP_(BACKTICK|HIGH|LOW)
              |GLOBAL_RANGE|HOSTNAME|NONE
              |NO_(RES|PRIV)_RANGE
              |NO_ENCODE_QUOTES
              |IPV(4|6)
              |EMPTY_STRING_NULL|EMAIL_UNICODE
              |ENCODE_(HIGH|LOW|AMP)
              |ALLOW_(SCIENTIFIC|HEX|THOUSAND|OCTAL|FRACTION)
        )
)
|INPUT_(REQUEST|GET|SERVER|SESSION|COOKIE|POST|ENV)
)