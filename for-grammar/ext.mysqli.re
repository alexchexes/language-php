             |(CONNECT|READ)_TIMEOUT|INT_AND_FLOAT_NATIVE|LOCAL_INFILE
             |CAN_HANDLE_EXPIRED_PASSWORDS|LOAD_DATA_LOCAL_DIR|SSL_VERIFY_SERVER_CERT
